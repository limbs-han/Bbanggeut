FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY requirements-service.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY . /app/video_editor

EXPOSE 18080
CMD ["uvicorn", "video_editor.service:app", "--host", "0.0.0.0", "--port", "18080"]
