#!/usr/bin/env bash
set -euo pipefail

incoming_root="/home/jenkins-deploy/incoming"
incoming_jar="${incoming_root}/server.jar.next"
incoming_bundle="${incoming_root}/backend-deploy.tar.gz"
application_root="/home/ubuntu/william-james"
current_jar="${application_root}/app/server.jar"
infra_root="${application_root}/infra"
infra_env="${infra_root}/.env"
infra_compose="${infra_root}/docker-compose.yml"
app_env="${application_root}/secrets/app.env"
nginx_config="/etc/nginx/sites-available/william-james"
release_root="${application_root}/releases/backend"
deployment_root="${application_root}/deployments"
health_url="http://127.0.0.1:8081/actuator/health"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
staging=""
backup_root="${release_root}/${timestamp}"
required_infra_files=(docker-compose.yml mediamtx.yml mosquitto.conf prometheus.yml grafana-datasources.yml)
required_bundle_files=("${required_infra_files[@]}" nginx-william-james.conf)
# 이 스크립트 자신의 사본. 아직 이 파일을 담지 않는 릴리스도 배포할 수 있어야
# 하므로 선택 항목으로 둔다. 담겨 있으면 설치본과 대조한다.
optional_bundle_files=(wj-deploy-backend)
previous_jar=""
had_current_jar=false
infra_replaced=false
jar_replaced=false
nginx_replaced=false
had_nginx_config=false
mediamtx_config_changed=false
mosquitto_config_changed=false
# editor-api: 릴리스에 editor-api/ 소스가 담겨 있으면 서버에서 이미지를
# 빌드해 함께 배포한다. 소스가 없는 옛 릴리스는 editor-api를 건드리지 않는다.
editor_image="wj-editor-api"
editor_health_url="http://127.0.0.1:18080/health"
editor_present=false
editor_replaced=false
editor_had_previous=false

cleanup() {
  if [[ -n "${staging}" && "${staging}" == "${application_root}"/.backend-deploy.* ]]; then
    rm -rf -- "${staging}"
  fi
}
trap cleanup EXIT

compose() {
  docker compose --env-file "${infra_env}" --file "${infra_compose}" "$@"
}

wait_for_healthy_service() {
  local service="$1"
  local container_id state health

  for _ in $(seq 1 60); do
    container_id="$(compose ps --all --quiet "${service}")"
    if [[ -n "${container_id}" ]]; then
      state="$(docker inspect --format '{{.State.Status}}' "${container_id}")"
      health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "${container_id}")"
      if [[ "${state}" == "running" && "${health}" == "healthy" ]]; then
        return 0
      fi
    fi
    sleep 2
  done

  echo "Infrastructure service did not become healthy: ${service}" >&2
  compose ps >&2 || true
  compose logs --tail 100 "${service}" >&2 || true
  return 1
}

wait_for_mediamtx() {
  local container_id state probe_port

  # 재생 경로가 WebRTC 전용으로 바뀌면서 mediamtx.yml 은 hls: false 다.
  # MediaMTX 는 HLS 포트 8888 을 아예 열지 않으므로, 8888 을 먼저 요구하면
  # 준비 검사가 영원히 실패해 배포가 통째로 막힌다. 실제로 켜 둔 재생
  # 프로토콜의 포트만 확인한다.
  if grep -Eq '^[[:space:]]*webrtc:[[:space:]]*true([[:space:]]|$)' \
    "${infra_root}/mediamtx.yml"
  then
    probe_port=8889
  else
    probe_port=8888
  fi

  for _ in $(seq 1 60); do
    container_id="$(compose ps --all --quiet mediamtx)"
    if [[ -n "${container_id}" ]]; then
      state="$(docker inspect --format '{{.State.Status}}' "${container_id}")"
      if [[ "${state}" == "running" ]] &&
        timeout 2 bash -c "</dev/tcp/127.0.0.1/${probe_port}" 2>/dev/null
      then
        return 0
      fi
    fi
    sleep 2
  done

  echo "MediaMTX did not become reachable on loopback port ${probe_port}." >&2
  compose logs --tail 100 mediamtx >&2 || true
  return 1
}

deploy_infrastructure() {
  # 로그인 시도 제한이 Redis 로 판정한다. 응답이 없으면 애플리케이션은
  # 시도를 허용하도록 되어 있어, 빠뜨리면 기동과 헬스 점검은 모두 정상인데
  # 제한만 걸리지 않는 상태로 서비스된다. 눈에 띄지 않는 실패라 다른 의존
  # 서비스와 같이 올리고 헬스까지 기다린다.
  compose up --detach --pull missing --remove-orphans postgres redis minio prometheus grafana
  if [[ "${mosquitto_config_changed}" == "true" ]]; then
    compose up --detach --pull missing --force-recreate mosquitto
  else
    compose up --detach --pull missing mosquitto
  fi
  if [[ "${mediamtx_config_changed}" == "true" ]]; then
    compose up --detach --pull missing --force-recreate mediamtx
  else
    compose up --detach --pull missing mediamtx
  fi
  wait_for_healthy_service postgres
  wait_for_healthy_service redis
  wait_for_healthy_service minio
  wait_for_healthy_service mosquitto
  wait_for_mediamtx
  compose run --rm minio-init
}

wait_for_editor_api() {
  for _ in $(seq 1 60); do
    if curl --fail --silent --max-time 3 "${editor_health_url}" >/dev/null; then
      return 0
    fi
    sleep 2
  done

  echo "editor-api did not answer its health check after deployment." >&2
  compose logs --tail 100 editor-api >&2 || true
  return 1
}

deploy_editor_api() {
  if [[ "${editor_present}" != "true" ]]; then
    return 0
  fi
  if docker image inspect "${editor_image}:latest" >/dev/null 2>&1; then
    docker tag "${editor_image}:latest" "${editor_image}:previous"
    editor_had_previous=true
  fi
  docker tag "${editor_image}:next" "${editor_image}:latest"
  editor_replaced=true
  compose up --detach editor-api
  wait_for_editor_api
}

restore_release() {
  trap - ERR
  set +e
  local rollback_ok=true

  echo "Deployment failed; restoring the previous backend release." >&2
  if [[ "${infra_replaced}" == "true" ]]; then
    for file in "${required_infra_files[@]}"; do
      if [[ -f "${backup_root}/infra/${file}" ]]; then
        install -o ubuntu -g ubuntu -m 0644 \
          "${backup_root}/infra/${file}" "${infra_root}/${file}" || rollback_ok=false
      else
        rm -f -- "${infra_root}/${file}" || rollback_ok=false
      fi
    done
    if compose config --quiet; then
      compose up --detach --pull missing --remove-orphans postgres redis minio ||
        rollback_ok=false
      # 복원된 compose가 옛 릴리스라면 관측성 서비스가 정의에 없다 —
      # 정의된 경우에만 올린다("no such service"로 롤백을 실패시키지 않는다).
      for optional_service in prometheus grafana; do
        if compose config --services 2>/dev/null | grep -Fxq "${optional_service}"; then
          compose up --detach --pull missing "${optional_service}" || rollback_ok=false
        fi
      done
      compose up --detach --pull missing --force-recreate mosquitto ||
        rollback_ok=false
      compose up --detach --pull missing --force-recreate mediamtx ||
        rollback_ok=false
      wait_for_healthy_service postgres || rollback_ok=false
      wait_for_healthy_service redis || rollback_ok=false
      wait_for_healthy_service minio || rollback_ok=false
      wait_for_healthy_service mosquitto || rollback_ok=false
      wait_for_mediamtx || rollback_ok=false
      compose run --rm minio-init || rollback_ok=false
    else
      rollback_ok=false
    fi
  fi

  if [[ "${editor_replaced}" == "true" ]]; then
    if [[ "${editor_had_previous}" == "true" ]]; then
      docker tag "${editor_image}:previous" "${editor_image}:latest" || rollback_ok=false
      # 복원된 compose 백업본에 editor-api 정의가 없을 수 있다(구 릴리스).
      # 그때 up 은 실패하므로 서비스가 정의된 경우에만 되살린다.
      if compose config --services 2>/dev/null | grep -Fxq editor-api; then
        compose up --detach --force-recreate editor-api || rollback_ok=false
      fi
    fi
    # 이전 이미지가 없던 최초 배포 실패라면 새 컨테이너를 그대로 둔다 —
    # 내리는 쪽이 더 파괴적이고, editor-api 는 백엔드와 독립적으로 동작한다.
  fi

  if [[ "${nginx_replaced}" == "true" ]]; then
    if [[ "${had_nginx_config}" == "true" ]]; then
      install -o root -g root -m 0644 \
        "${backup_root}/nginx-william-james.conf" "${nginx_config}" ||
        rollback_ok=false
    else
      rm -f -- "${nginx_config}" || rollback_ok=false
    fi
    nginx -t || rollback_ok=false
    systemctl reload nginx || rollback_ok=false
  fi

  if [[ "${jar_replaced}" == "true" ]]; then
    if [[ "${had_current_jar}" == "true" && -n "${previous_jar}" && -f "${previous_jar}" ]]; then
      install -o ubuntu -g ubuntu -m 0644 \
        "${previous_jar}" "${current_jar}.rollback" || rollback_ok=false
      mv -f "${current_jar}.rollback" "${current_jar}" || rollback_ok=false
      systemctl restart william-james || rollback_ok=false
    else
      rm -f -- "${current_jar}" || rollback_ok=false
      systemctl stop william-james || rollback_ok=false
    fi
  fi

  if [[ "${rollback_ok}" == "true" ]]; then
    printf '%s status=ROLLED_BACK backup=%s\n' "${timestamp}" "${backup_root}" \
      >>"${deployment_root}/backend.log"
  else
    printf '%s status=ROLLBACK_FAILED backup=%s\n' "${timestamp}" "${backup_root}" \
      >>"${deployment_root}/backend.log"
    echo "Automatic rollback did not fully recover the previous release." >&2
  fi

  # 핸들러 안의 set +e가 errexit 종료를 무효화해서, 여기서 명시적으로
  # 끝내지 않으면 스크립트가 실패 지점 다음 줄부터 계속 실행된다 —
  # 2026-08-04 배포에서 롤백된 인프라 위에 새 JAR가 올라가고 status=SUCCESS
  # 까지 찍혔다. 롤백이 곧 배포 실패다.
  exit 1
}

validate_spring_boot_jar() {
  local candidate="${1:?JAR path is required}"

  if ! command -v unzip >/dev/null 2>&1; then
    echo "JAR 검증에 필요한 unzip 명령이 없습니다." >&2
    return 1
  fi

  if [[ ! -f "${candidate}" ]]; then
    echo "검증할 JAR가 없습니다: ${candidate}" >&2
    return 1
  fi

  if ! unzip -tq "${candidate}" >/dev/null; then
    echo "업로드된 파일의 ZIP/JAR 구조가 손상되었습니다." >&2
    return 1
  fi

  if ! unzip -Z1 "${candidate}" |
    awk '
      $0 == "META-INF/MANIFEST.MF" { manifest = 1 }
      index($0, "BOOT-INF/classes/") == 1 { classes = 1 }
      index($0, "BOOT-INF/lib/") == 1 { libraries = 1 }
      END { exit !(manifest && classes && libraries) }
    '
  then
    echo "업로드된 파일이 실행 가능한 Spring Boot JAR 구조가 아닙니다." >&2
    return 1
  fi
}

if [[ "${1:-}" == "--validate-only" ]]; then
  if [[ "$#" -ne 2 ]]; then
    echo "사용법: $0 --validate-only <JAR 경로>" >&2
    exit 2
  fi
  validate_spring_boot_jar "$2"
  echo "Spring Boot JAR 검증 성공: $2"
  exit 0
fi

staging="$(mktemp -d "${application_root}/.backend-deploy.XXXXXX")"

exec 9>/run/lock/william-james-backend-deploy.lock
if ! flock -n 9; then
  echo "Another backend deployment is already running." >&2
  exit 1
fi

if [[ ! -f "${incoming_jar}" ]]; then
  echo "Deployment JAR is missing: ${incoming_jar}" >&2
  exit 1
fi
if [[ ! -s "${incoming_bundle}" ]]; then
  echo "Infrastructure deployment artifact is missing: ${incoming_bundle}" >&2
  exit 1
fi
if [[ ! -s "${infra_env}" ]]; then
  echo "Server-managed infrastructure secret file is missing: ${infra_env}" >&2
  exit 1
fi
if [[ ! -s "${app_env}" ]]; then
  echo "Server-managed application environment file is missing: ${app_env}" >&2
  exit 1
fi
if ! validate_spring_boot_jar "${incoming_jar}"; then
  exit 1
fi

bundle_entries="$(tar --list --gzip --file "${incoming_bundle}" | LC_ALL=C sort)"
if printf '%s\n' "${bundle_entries}" | grep -Eq '(^|/)\.\.(/|$)|^/'; then
  echo "Infrastructure artifact contains an unsafe path." >&2
  exit 1
fi
# editor-api/ 아래는 소스 트리 전체가 오므로 파일 단위로 고정하지 않고,
# 나머지 항목만 기존처럼 알려진 집합과 대조한다.
non_editor_entries="$(printf '%s\n' "${bundle_entries}" | grep -v '^editor-api/' || true)"
allowed_entries="$(
  printf '%s\n' "${required_bundle_files[@]}" "${optional_bundle_files[@]}" |
    LC_ALL=C sort
)"
if [[ -n "$(comm -23 <(printf '%s\n' "${non_editor_entries}") \
  <(printf '%s\n' "${allowed_entries}"))" ]]; then
  echo "Infrastructure artifact contains an unexpected file set." >&2
  printf 'Allowed:\n%s\nActual:\n%s\n' "${allowed_entries}" "${non_editor_entries}" >&2
  exit 1
fi
if printf '%s\n' "${bundle_entries}" | grep -q '^editor-api/'; then
  for file in Dockerfile.local service.py requirements-service.txt; do
    if ! printf '%s\n' "${bundle_entries}" | grep -Fxq "editor-api/${file}"; then
      echo "editor-api source in the artifact is missing a required file: ${file}" >&2
      exit 1
    fi
  done
  editor_present=true
fi
for file in "${required_bundle_files[@]}"; do
  if ! printf '%s\n' "${bundle_entries}" | grep -Fxq "${file}"; then
    echo "Infrastructure artifact is missing a required file: ${file}" >&2
    exit 1
  fi
done
tar --extract --gzip --file "${incoming_bundle}" \
  --directory "${staging}" --no-same-owner --no-same-permissions

for file in "${required_bundle_files[@]}"; do
  if [[ ! -s "${staging}/${file}" ]]; then
    echo "Infrastructure artifact file is missing or empty: ${file}" >&2
    exit 1
  fi
done

# 이 스크립트는 저장소 파일의 복사본이고 Jenkins 는 그것을 갱신하지 않는다.
# 저장소에서 고쳐도 재설치 전까지 운영에는 반영되지 않으며, 그동안 배포는
# 계속 성공으로 끝난다. Redis 서비스가 몇 주 동안 빠진 채 배포된 원인이
# 이것이므로, 어긋난 것을 확인하면 배포를 진행하지 않는다.
installed_wrapper="${BASH_SOURCE[0]}"
if [[ -s "${staging}/wj-deploy-backend" ]]; then
  if ! cmp --silent "${staging}/wj-deploy-backend" "${installed_wrapper}"; then
    cat >&2 <<EOF
설치된 배포 스크립트가 이번 릴리스의 저장소 사본과 다릅니다.
  설치본: ${installed_wrapper}
  릴리스: ${staging}/wj-deploy-backend
저장소를 체크아웃한 위치에서 아래를 실행해 설치본을 갱신한 뒤 다시 배포하세요.
  sudo install -o root -g root -m 0755 \\
    ci/jenkins/server/deploy/wj-deploy-backend \\
    /usr/local/sbin/wj-deploy-backend
EOF
    exit 1
  fi
  echo "배포 스크립트 설치본이 릴리스와 일치합니다."
else
  echo "경고: 이번 릴리스에 배포 스크립트 사본이 없어 설치본 일치를 확인하지 못했습니다." >&2
fi

# Validate the candidate Compose model against server-owned secrets before
# replacing any live file. Relative bind mounts resolve inside staging.
docker compose --env-file "${infra_env}" \
  --file "${staging}/docker-compose.yml" config --quiet

# editor-api 이미지는 라이브 파일을 하나도 바꾸기 전에 빌드한다. 빌드가
# 실패하면 배포 전체가 아무것도 건드리지 않은 채 중단된다.
if [[ "${editor_present}" == "true" ]]; then
  if ! grep -Eq '^EDITOR_JWT_SECRET=..+' "${infra_env}"; then
    cat >&2 <<EOF
infra/.env 에 EDITOR_JWT_SECRET 이 없습니다. editor-api 는 이 값(백엔드
JWT_SIGNING_KEY와 같은 값)이 없으면 기동을 거부하므로 배포를 중단합니다.
EOF
    exit 1
  fi
  # .env에 값이 없으면 grep이 1을 반환하는데, pipefail 아래에서 이 치환이
  # 스크립트를 아무 메시지 없이 즉사시킨다 — 2026-08-04 배포 #71이 이렇게
  # 죽었다. 기본 경로 폴백이 있으므로 빈 결과는 정상이다.
  editor_model_dir="$(grep -E '^EDITOR_MODEL_DIR=' "${infra_env}" | tail -1 | cut -d= -f2- || true)"
  editor_model_dir="${editor_model_dir:-/home/ubuntu/william-james/editor-models}"
  if [[ ! -d "${editor_model_dir}" || -z "$(ls -A "${editor_model_dir}" 2>/dev/null)" ]]; then
    echo "경고: ${editor_model_dir} 에 분석 모델이 없습니다. editor-api 는 뜨지만 분석은 503 입니다." >&2
  fi
  echo "Building editor-api image from the release source..."
  docker build --tag "${editor_image}:next" \
    --file "${staging}/editor-api/Dockerfile.local" "${staging}/editor-api"
fi

if [[ ! -f "${infra_root}/mediamtx.yml" ]] ||
  ! cmp --silent "${staging}/mediamtx.yml" "${infra_root}/mediamtx.yml"
then
  mediamtx_config_changed=true
fi
if [[ ! -f "${infra_root}/mosquitto.conf" ]] ||
  ! cmp --silent "${staging}/mosquitto.conf" "${infra_root}/mosquitto.conf"
then
  mosquitto_config_changed=true
fi

install -d -o ubuntu -g ubuntu -m 0750 \
  "${release_root}" "${deployment_root}" "${backup_root}/infra"

for file in "${required_infra_files[@]}"; do
  if [[ -f "${infra_root}/${file}" ]]; then
    install -o ubuntu -g ubuntu -m 0644 \
      "${infra_root}/${file}" "${backup_root}/infra/${file}"
  fi
done

if [[ -f "${nginx_config}" ]]; then
  had_nginx_config=true
  install -o root -g root -m 0644 \
    "${nginx_config}" "${backup_root}/nginx-william-james.conf"
fi

infra_replaced=true
trap restore_release ERR
for file in "${required_infra_files[@]}"; do
  install -o ubuntu -g ubuntu -m 0644 \
    "${staging}/${file}" "${infra_root}/${file}.next"
  mv -f "${infra_root}/${file}.next" "${infra_root}/${file}"
done

install -o root -g root -m 0644 \
  "${staging}/nginx-william-james.conf" "${nginx_config}.next"
mv -f "${nginx_config}.next" "${nginx_config}"
nginx_replaced=true
nginx -t
systemctl reload nginx

if grep -q '^WEBRTC_BASE_URL=' "${app_env}"; then
  sed -i \
    's|^WEBRTC_BASE_URL=.*$|WEBRTC_BASE_URL=https://i15e201.p.ssafy.io/webrtc/live|' \
    "${app_env}"
else
  printf '%s\n' \
    'WEBRTC_BASE_URL=https://i15e201.p.ssafy.io/webrtc/live' >>"${app_env}"
fi

# 양방향 오디오 발화 URL. 기본값은 로컬 개발용 localhost 라서, 여기서 넣지
# 않으면 배포는 성공하고 앱만 닿을 수 없는 주소를 받는다. 재생 URL과 같은
# 이유로 공개 주소이며 비밀값이 아니다.
if grep -q '^TALKBACK_WHIP_BASE_URL=' "${app_env}"; then
  sed -i \
    's|^TALKBACK_WHIP_BASE_URL=.*$|TALKBACK_WHIP_BASE_URL=https://i15e201.p.ssafy.io/webrtc/talkback|' \
    "${app_env}"
else
  printf '%s\n' \
    'TALKBACK_WHIP_BASE_URL=https://i15e201.p.ssafy.io/webrtc/talkback' >>"${app_env}"
fi

# MediaMTX 관리 API 주소. 비어 있으면 백엔드의 유령 세션 대사가 꺼진 채
# 돌아가므로, 배포가 loopback 주소를 채워 준다. 공개 주소가 아니다.
if grep -q '^MEDIAMTX_API_BASE_URL=' "${app_env}"; then
  sed -i \
    's|^MEDIAMTX_API_BASE_URL=.*$|MEDIAMTX_API_BASE_URL=http://127.0.0.1:9997|' \
    "${app_env}"
else
  printf '%s\n' 'MEDIAMTX_API_BASE_URL=http://127.0.0.1:9997' >>"${app_env}"
fi

# FCM 푸시 설정. 서비스 계정 JSON을 아래 경로에 두고 FCM_ENABLED=true 로
# 바꾸면 다음 재시작부터 푸시가 나간다. 배포는 **없을 때 기본값만 채운다**
# — 운영자가 켜 둔 값을 배포가 도로 끄면 푸시가 소리 없이 죽는다.
if ! grep -q '^FCM_ENABLED=' "${app_env}"; then
  printf '%s\n' 'FCM_ENABLED=false' >>"${app_env}"
fi
if ! grep -q '^FIREBASE_PROJECT_ID=' "${app_env}"; then
  printf '%s\n' 'FIREBASE_PROJECT_ID=' >>"${app_env}"
fi
if ! grep -q '^GOOGLE_APPLICATION_CREDENTIALS=' "${app_env}"; then
  printf '%s\n' \
    'GOOGLE_APPLICATION_CREDENTIALS=/home/ubuntu/william-james/secrets/firebase-service-account.json' \
    >>"${app_env}"
fi
chmod 600 "${app_env}"

incoming_sha="$(sha256sum "${incoming_jar}" | awk '{print $1}')"
if [[ -f "${current_jar}" ]]; then
  had_current_jar=true
  previous_sha="$(sha256sum "${current_jar}" | awk '{print $1}')"
  previous_jar="${backup_root}/server-${previous_sha:0:12}.jar"
  install -o ubuntu -g ubuntu -m 0644 "${current_jar}" "${previous_jar}"
fi

deploy_infrastructure
deploy_editor_api

install -o ubuntu -g ubuntu -m 0644 "${incoming_jar}" "${current_jar}.next"
mv -f "${current_jar}.next" "${current_jar}"
jar_replaced=true
systemctl restart william-james

healthy=false
for _ in $(seq 1 30); do
  if curl --fail --silent --max-time 3 "${health_url}" >/dev/null; then
    healthy=true
    break
  fi
  sleep 2
done
if [[ "${healthy}" != "true" ]]; then
  echo "Spring Boot health check failed after deployment." >&2
  false
fi

rm -f -- "${incoming_jar}" "${incoming_bundle}"
infra_replaced=false
jar_replaced=false
nginx_replaced=false
editor_replaced=false
if [[ "${editor_present}" == "true" ]]; then
  # :next 는 :latest 와 같은 이미지를 가리키므로 태그만 걷는다. :previous 는
  # 수동 롤백용으로 남긴다.
  docker rmi "${editor_image}:next" >/dev/null 2>&1 || true
fi
trap - ERR

deployed_services="postgres,redis,minio,mosquitto,mediamtx,nginx"
if [[ "${editor_present}" == "true" ]]; then
  deployed_services="${deployed_services},editor-api"
fi
printf '%s status=SUCCESS sha256=%s backup=%s services=%s\n' \
  "${timestamp}" "${incoming_sha}" "${backup_root}" "${deployed_services}" \
  >>"${deployment_root}/backend.log"
echo "Backend application and infrastructure deployment succeeded: ${incoming_sha}"
