FROM jenkins/inbound-agent@sha256:b0c41a6b69468ac7c72ad25c2a364e6b5f116a1ea44510642bd629a6323f0fab AS java17

FROM jenkins/inbound-agent@sha256:6274f49f86429c5382b3943e96df81b65fd81712677347ae2a50b235b6c4e286

COPY --from=java17 /opt/java/openjdk /usr/lib/jvm/java-17-jenkins

USER root
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential \
        postgresql-client \
        python3 \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*
USER jenkins
