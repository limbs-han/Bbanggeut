[Unit]
Description=William James 상시 실행 USB 홈카메라 publisher
Requires=mediamtx.service
After=network-online.target mediamtx.service

[Service]
Type=simple
User=pi
Group=video
EnvironmentFile=-/etc/william-james/homecam-publisher.env
ExecStart=/opt/william-james/device-agent/homecam-publisher.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
