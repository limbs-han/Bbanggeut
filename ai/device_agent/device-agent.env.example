DEVICE_ID=11111111-1111-4111-8111-111111111111
DEVICE_BEARER_TOKEN=wj_replace_me
FIRMWARE_VERSION=0.1.0
NODE_ID=pi-gateway

MQTT_HOST=i15e201.p.ssafy.io
MQTT_PORT=8883
MQTT_ENV=prod
MQTT_CA_CERT=/etc/william-james/certs/mqtt-ca.crt

# {stream_id} is replaced with the UUID received in START_STREAM.
# Use rtsp://127.0.0.1:8554/live/{stream_id} only while testing through a tunnel.
MEDIA_PUBLISH_URL_TEMPLATE=rtsps://wj-device:replace_me@i15e201.p.ssafy.io:8322/live/{stream_id}
MEDIA_TLS_CA_CERT=/etc/ssl/certs/ca-certificates.crt

FFMPEG_PATH=/usr/bin/ffmpeg
CAMERA_DEVICE=/dev/video0
CAMERA_INPUT_FORMAT=mjpeg
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
VIDEO_BITRATE=2500k
READY_DELAY_SECONDS=3

# Override these JSON arrays on Jetson to replace the V4L2 input or encoder.
# Quote the whole JSON value so systemd preserves its inner double quotes.
# FFMPEG_INPUT_ARGS='["-f","v4l2","-input_format","mjpeg","-framerate","30","-video_size","1280x720","-i","/dev/video0"]'
# FFMPEG_VIDEO_ARGS='["-c:v","libx264","-preset","ultrafast","-tune","zerolatency","-pix_fmt","yuv420p","-g","60","-bf","0","-b:v","2500k"]'
