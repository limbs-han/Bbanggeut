[Unit]
Description=MediaMTX Pi 내부 홈카메라 미디어 서버
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
Group=video
ExecStart=/usr/local/bin/mediamtx /etc/william-james/mediamtx.yml
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
