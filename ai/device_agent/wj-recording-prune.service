[Unit]
Description=Prune expired William James homecam recordings
Wants=wj-event-prune.service
After=wj-event-prune.service

[Service]
Type=oneshot
User=williamjames
Group=williamjames
EnvironmentFile=/etc/william-james/device-agent.env
ExecStart=/opt/william-james/device-agent/recording-prune.sh
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/var/lib/william-james/recordings
