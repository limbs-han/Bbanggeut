[Unit]
Description=Prune bounded William James Jetson event artifacts
Before=wj-recording-prune.service

[Service]
Type=oneshot
User=ssafy
Group=ssafy
Environment=HOME=/home/ssafy
Environment=EVENT_DIR=/home/ssafy/ai_events
EnvironmentFile=/etc/william-james/device-agent.env
ExecStart=/usr/bin/python3 /opt/william-james/device-agent/event_prune.py
NoNewPrivileges=true
PrivateTmp=true
