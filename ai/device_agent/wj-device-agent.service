[Unit]
Description=William James IoT 스트리밍 기기 에이전트
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
Group=video
SupplementaryGroups=audio
EnvironmentFile=/etc/william-james/device-agent.env
WorkingDirectory=/opt/william-james/device-agent
ExecStart=/opt/william-james/device-agent/venv/bin/python -m wj_device_agent
Restart=always
RestartSec=5
TimeoutStopSec=12
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
