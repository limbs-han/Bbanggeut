# Values returned by backend device provisioning. The device must also be
# claimed by the owner/admin account in the app.
DEVICE_ID=11111111-1111-4111-8111-111111111111
DEVICE_BEARER_TOKEN=wj_replace_me
FIRMWARE_VERSION=0.1.0-jetson
NODE_ID=jetson-gateway

MQTT_HOST=i15e201.p.ssafy.io
MQTT_PORT=8883
MQTT_ENV=prod
MQTT_CA_CERT=/etc/william-james/certs/mqtt-ca.crt
API_BASE_URL=https://i15e201.p.ssafy.io

# Direct authenticated RTSPS publish. Replace the example credential with
# configure-jetson-rtsps.sh; never commit the resulting environment file.
MEDIA_PUBLISH_URL_TEMPLATE=rtsps://wj-jetson-001:replace_me@i15e201.p.ssafy.io:8322/live/{stream_id}
MEDIA_TLS_CA_CERT=/etc/william-james/certs/mediamtx-ca.crt
# Verify this CA-certificate fingerprint through a separate trusted channel.
MEDIA_TLS_CA_SHA256=replace_with_ca_certificate_sha256

# SSH tunnel rollback. These values remain installed but the tunnel is not
# started for direct RTSPS. To roll back, start wj-media-tunnel, switch the
# publish URL to authenticated rtsp://...@127.0.0.1:18554/live/{stream_id}
# with configure-jetson-rtsps.sh --scheme rtsp, and restart the agent.
MEDIA_SSH_HOST=i15e201.p.ssafy.io
MEDIA_SSH_USER=ubuntu
MEDIA_SSH_PORT=22
MEDIA_SSH_KEY=/etc/william-james/ssh/media-tunnel.key
MEDIA_SSH_KNOWN_HOSTS=/etc/william-james/ssh/known_hosts
MEDIA_TUNNEL_LOCAL_PORT=18554
MEDIA_TUNNEL_REMOTE_HOST=127.0.0.1
MEDIA_TUNNEL_REMOTE_PORT=8554

FFMPEG_PATH=/usr/bin/ffmpeg
CAMERA_DEVICE=/dev/video0
CAMERA_INPUT_FORMAT=mjpeg
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
VIDEO_BITRATE=2500k
AUDIO_DEVICE=plughw:CARD=B100,DEV=0
READY_DELAY_SECONDS=3
CAMERA_WAIT_SECONDS=5

# The always-on media source opens the hardware once and publishes four
# loopback-only MPEG-TS copies. Nothing leaves the Jetson from these ports.
YOLO_UDP_PORT=23000
YAMNET_UDP_PORT=23001
LIVE_UDP_PORT=23002
LOCAL_RTSP_UDP_PORT=23003
YOLO_SOURCE_URL=udp://127.0.0.1:23000?fifo_size=1000000&overrun_nonfatal=1
YAMNET_SOURCE_URL=udp://127.0.0.1:23001?fifo_size=1000000&overrun_nonfatal=1

# Optional loopback RTSP and seven-day recording services. Keep YOLO/YAMNet on
# the UDP URLs above until the one-hour RTSP validation passes.
MEDIAMTX_PATH=/usr/local/bin/mediamtx
LOCAL_MEDIAMTX_CONFIG=/etc/william-james/mediamtx-local.yml
LOCAL_RTSP_MAIN_URL=rtsp://127.0.0.1:8554/homecam/main
LOCAL_RTSP_AI_URL=rtsp://127.0.0.1:8554/homecam/ai
RECORDING_DIR=/var/lib/william-james/recordings
RECORDING_SEGMENT_SECONDS=60
RECORDING_RETENTION_DAYS=7
# Temporary limit for testing on the Jetson's 64GB root disk.
RECORDING_MAX_GIB=8
RECORDING_TIMEZONE=UTC
EVENT_CLIP_SECONDS=60
EVENT_MERGE_GAP_SECONDS=30
DELETE_EVENT_AFTER_UPLOAD=true
YAMNET_THRESHOLD=0.05
YAMNET_CONSECUTIVE=2
YOLO_DEADZONE_WIDTH=0.08
YOLO_DEADZONE_HEIGHT=0.06
YOLO_SUBJECT_Y_RATIO=0.35
SERVO_DASHBOARD_HOST=127.0.0.1
SERVO_DASHBOARD_PORT=8765
SERVO_DASHBOARD_FRAME_WIDTH=960
SERVO_DASHBOARD_JPEG_QUALITY=72
SERVO_DASHBOARD_FRAME_INTERVAL_SECONDS=0.2

# Optional Jetson registration button and I2C LCD. On the Orin Nano developer
# kit, physical pin 7 is gpiochip0 line 144 (PAC.06); wire the button to GND.
REGISTRATION_BUTTON_CHIP=0
REGISTRATION_BUTTON_LINE=144
REGISTRATION_BUTTON_TIMEOUT_SECONDS=30
LCD_I2C_BUS=7
LCD_I2C_ADDRESS=0x27
LCD_COLUMNS=16

# Local auto-framing servo controller. Hardware remains disabled until a
# separate regulated 5V servo supply, common GND, I2C bus and pulse directions
# have been physically verified.
LOCAL_MQTT_HOST=127.0.0.1
LOCAL_MQTT_PORT=1883
SERVO_MQTT_HOST=127.0.0.1
SERVO_MQTT_PORT=1883
SERVO_ENABLE_HARDWARE=false
# Set after running `i2cdetect -l`; do not guess the Jetson I2C bus number.
# SERVO_I2C_BUS=7
SERVO_I2C_ADDRESS=0x40
SERVO_PAN_CHANNEL=0
SERVO_TILT_CHANNEL=1
# Home is logical 0 degrees. Both axes are clamped to 80 degrees in either
# direction after checking the mount's mechanical limits.
SERVO_PAN_MIN_DEG=-80
SERVO_PAN_MAX_DEG=80
SERVO_TILT_MIN_DEG=-50
SERVO_TILT_MAX_DEG=80
SERVO_PAN_PARK_DEG=0
SERVO_TILT_PARK_DEG=-50
SERVO_PAN_PULSE_DIRECTION=1
SERVO_TILT_PULSE_DIRECTION=1
SERVO_PAN_HOME_PULSE_US=1500
SERVO_TILT_HOME_PULSE_US=1500
SERVO_PAN_PULSE_US_PER_DEGREE=5.555556
SERVO_TILT_PULSE_US_PER_DEGREE=5.555556
SERVO_MINIMUM_PULSE_US=1000
SERVO_MAXIMUM_PULSE_US=2000
# The controller restores this position before its first PWM pulse. Missing,
# stale or invalid state keeps hardware in STARTUP_WAITING with outputs off.
SERVO_STATE_FILE=/var/lib/william-james-servo/position.json
SERVO_STATE_MAX_AGE_SECONDS=604800
SERVO_STATE_SAVE_INTERVAL_SECONDS=0.25
SERVO_SHUTDOWN_HOME_TIMEOUT_SECONDS=3

# Live View relays the already encoded local stream only while a viewer exists.
FFMPEG_INPUT_ARGS='["-fflags","nobuffer","-flags","low_delay","-i","udp://127.0.0.1:23002?fifo_size=1000000&overrun_nonfatal=1"]'
FFMPEG_VIDEO_ARGS='["-c:v","copy"]'
FFMPEG_AUDIO_INPUT_ARGS='[]'
FFMPEG_AUDIO_ARGS='["-c:a","libopus","-b:a","64k","-ar","48000","-ac","1","-application","lowdelay"]'
FFMPEG_AUDIO_FROM_PRIMARY_INPUT=true
