# Values returned by backend device provisioning. The device must also be
# claimed by the owner/admin account in the app.
DEVICE_ID=11111111-1111-4111-8111-111111111111
DEVICE_BEARER_TOKEN=wj_replace_me
FIRMWARE_VERSION=0.1.0-jetson
NODE_ID=jetson-gateway

MQTT_HOST=i15e201.p.ssafy.io
MQTT_PORT=8883
MQTT_ENV=prod
MQTT_CA_CERT=/etc/william-james/certs/mqtt-ca.crt
API_BASE_URL=https://i15e201.p.ssafy.io

# Direct authenticated RTSPS publish. Replace the example credential with
# configure-jetson-rtsps.sh; never commit the resulting environment file.
MEDIA_PUBLISH_URL_TEMPLATE=rtsps://wj-jetson-001:replace_me@i15e201.p.ssafy.io:8322/live/{stream_id}
MEDIA_TLS_CA_CERT=/etc/william-james/certs/mediamtx-ca.crt
# Verify this CA-certificate fingerprint through a separate trusted channel.
MEDIA_TLS_CA_SHA256=replace_with_ca_certificate_sha256

# SSH tunnel rollback. These values remain installed but the tunnel is not
# started for direct RTSPS. To roll back, start wj-media-tunnel, switch the
# publish URL to authenticated rtsp://...@127.0.0.1:18554/live/{stream_id}
# with configure-jetson-rtsps.sh --scheme rtsp, and restart the agent.
MEDIA_SSH_HOST=i15e201.p.ssafy.io
MEDIA_SSH_USER=ubuntu
MEDIA_SSH_PORT=22
MEDIA_SSH_KEY=/etc/william-james/ssh/media-tunnel.key
MEDIA_SSH_KNOWN_HOSTS=/etc/william-james/ssh/known_hosts
MEDIA_TUNNEL_LOCAL_PORT=18554
MEDIA_TUNNEL_REMOTE_HOST=127.0.0.1
MEDIA_TUNNEL_REMOTE_PORT=8554

FFMPEG_PATH=/usr/bin/ffmpeg
CAMERA_DEVICE=/dev/video0
CAMERA_INPUT_FORMAT=mjpeg
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
VIDEO_BITRATE=2500k
AUDIO_DEVICE=plughw:CARD=B100,DEV=0
READY_DELAY_SECONDS=3
CAMERA_WAIT_SECONDS=5

# The always-on media source opens the hardware once and publishes four
# loopback-only MPEG-TS copies. Nothing leaves the Jetson from these ports.
YOLO_UDP_PORT=23000
YAMNET_UDP_PORT=23001
LIVE_UDP_PORT=23002
LOCAL_RTSP_UDP_PORT=23003
YOLO_SOURCE_URL=udp://127.0.0.1:23000?fifo_size=1000000&overrun_nonfatal=1
YAMNET_SOURCE_URL=udp://127.0.0.1:23001?fifo_size=1000000&overrun_nonfatal=1

# Optional loopback RTSP and seven-day recording services. Keep YOLO/YAMNet on
# the UDP URLs above until the one-hour RTSP validation passes.
MEDIAMTX_PATH=/usr/local/bin/mediamtx
LOCAL_MEDIAMTX_CONFIG=/etc/william-james/mediamtx-local.yml
LOCAL_RTSP_MAIN_URL=rtsp://127.0.0.1:8554/homecam/main
LOCAL_RTSP_AI_URL=rtsp://127.0.0.1:8554/homecam/ai
RECORDING_DIR=/var/lib/william-james/recordings
RECORDING_SEGMENT_SECONDS=60
RECORDING_RETENTION_DAYS=7
# Temporary limit for testing on the Jetson's 64GB root disk.
RECORDING_MAX_GIB=8
RECORDING_TIMEZONE=Asia/Seoul
EVENT_DIR=/home/ssafy/ai_events
# Permanent upload failures expire before rolling recordings. Under storage
# pressure, blocked bundles are also deleted before completed, log, or pending
# event data. Files modified within the active grace window are never pruned.
EVENT_BLOCKED_RETENTION_DAYS=3
EVENT_RETENTION_DAYS=7
EVENT_LOG_RETENTION_DAYS=3
EVENT_MAX_GIB=2
EVENT_MIN_FREE_GIB=4
EVENT_ACTIVE_GRACE_MINUTES=15
EVENT_CLIP_SECONDS=60
EVENT_MERGE_GAP_SECONDS=30
EVENT_CROSS_TYPE_MERGE_GAP_SECONDS=5
DELETE_EVENT_AFTER_UPLOAD=true
# Which model holds audio event authority: efficientat, yamnet or none.
# EfficientAT MN10 is the operational detector; yamnet is the rollback.
# Exactly one detector writes triggers, so events are never produced twice.
AUDIO_EVENT_MODEL=efficientat
# Laughter sensitivity: sensitive, default or insensitive.
#   sensitive    laughter threshold 0.0169 - also fires on ordinary indoor
#                conversation, which was observed scoring 0.072. Accepted cost.
#   default      0.03 - detection first, still under conversation.
#   insensitive  0.08 - the only step that clears conversation while staying
#                under the observed laughter floor of 0.229.
AUDIO_SENSITIVITY=default
# Setting AUDIO_SHADOW_LAUGHTER_THRESHOLD here pins the value and makes
# AUDIO_SENSITIVITY do nothing. Leave it unset unless running an experiment.
AUDIO_SHADOW_LAUGHTER_CONSECUTIVE=1
AUDIO_SHADOW_CLAP_THRESHOLD=0.08725224
# Clapping needs 2: one window cannot tell sustained applause from a door slam.
AUDIO_SHADOW_CLAP_CONSECUTIVE=2
AUDIO_SHADOW_CONTEXT_SECONDS=10
AUDIO_SHADOW_HOP_SECONDS=2.5
AUDIO_SHADOW_COOLDOWN_SECONDS=12
AUDIO_SHADOW_MODEL_PATH=/home/ssafy/ai_models/audio-benchmark/efficientat_mn10_as.pt
AUDIO_SHADOW_SOURCE_REPO=/home/ssafy/ai_models/audio-benchmark/sources/EfficientAT
AUDIO_SHADOW_DEVICE=cuda
AUDIO_SHADOW_PRECISION=fp16
# CLAP events stay off until the Backend CLAP contract is deployed.
AUDIO_EVENT_CLAP_ENABLED=false
# Rollback path only. These apply when AUDIO_EVENT_MODEL=yamnet and are
# ignored otherwise.
YAMNET_THRESHOLD=0.05
YAMNET_CONSECUTIVE=2
YAMNET_CLAP_ENABLED=false
YAMNET_CLAP_THRESHOLD=0.30
YAMNET_CLAP_CONSECUTIVE=2
YAMNET_CLAP_REQUIRED_ONSETS=3
YAMNET_CLAP_MIN_ACTIVE_SECONDS=0.4
YAMNET_CLAP_MAX_GAP_SECONDS=0.75
YAMNET_CLAP_COOLDOWN=12
YOLO_DEADZONE_WIDTH=0.08
YOLO_DEADZONE_HEIGHT=0.06
# The Jetson runs 0.05. Keep this in step with the device; a stale value here
# reads as the operating point to anyone who only looks at the repo.
YOLO_SUBJECT_Y_RATIO=0.05
YOLO_TRACKING_MODE=safe-frame
YOLO_SAFE_FRAME_START_MARGIN=0.08
YOLO_SAFE_FRAME_STOP_MARGIN=0.12
YOLO_SAFE_FRAME_EDGE_GUARD=0.04
YOLO_TARGET_LOSS_FOLLOW_SECONDS=0.5
# auto prefers the locally built TensorRT engine after a startup inference
# probe. A missing, mismatched or incompatible engine falls back to the
# packaged PyTorch model. Use tensorrt for strict validation and pytorch for
# an immediate rollback. TensorRT engines are JetPack/GPU specific and are not
# committed to Git.
YOLO_RUNTIME=auto
YOLO_TENSORRT_ENGINE_PATH=/home/ssafy/ai_models/yolo-detect-engine/yolov8n-fp16-b1-640.engine
# Set this to the SHA-256 verified during engine build before promotion.
YOLO_TENSORRT_ENGINE_SHA256=
YOLO_PYTORCH_MODEL_PATH=/home/ssafy/ai/yolo/yolov8n.pt
YOLO_TENSORRT_PROBE=true
YOLO_TENSORRT_PROBE_DEVICE=0
SERVO_DASHBOARD_HOST=127.0.0.1
SERVO_DASHBOARD_PORT=8765
SERVO_DASHBOARD_FRAME_WIDTH=960
SERVO_DASHBOARD_JPEG_QUALITY=72
SERVO_DASHBOARD_FRAME_INTERVAL_SECONDS=0.2

# Optional Jetson registration button and I2C LCD. On the Orin Nano developer
# kit, physical pin 7 is gpiochip0 line 144 (PAC.06); wire the button to GND.
REGISTRATION_BUTTON_CHIP=0
REGISTRATION_BUTTON_LINE=144
REGISTRATION_BUTTON_TIMEOUT_SECONDS=30
LCD_I2C_BUS=7
LCD_I2C_ADDRESS=0x27
LCD_COLUMNS=16
# A failed request shows "Failed", then the reason, then the ready screen again.
REGISTRATION_FAILURE_REASON_SECONDS=3
REGISTRATION_FAILURE_READY_SECONDS=5

# Local auto-framing servo controller. Hardware remains disabled until a
# separate regulated 5V servo supply, common GND, I2C bus and pulse directions
# have been physically verified.
LOCAL_MQTT_HOST=127.0.0.1
LOCAL_MQTT_PORT=1883
SERVO_MQTT_HOST=127.0.0.1
SERVO_MQTT_PORT=1883
SERVO_ENABLE_HARDWARE=false
# Set after running `i2cdetect -l`; do not guess the Jetson I2C bus number.
# SERVO_I2C_BUS=7
# Verified with i2cdetect on 2026-08-06. The chip default is 0x40; this board
# answers at 0x60. Never guess it.
SERVO_I2C_ADDRESS=0x60
SERVO_PAN_CHANNEL=0
SERVO_TILT_CHANNEL=1
# Both axes PARK at logical 0, and the servo horns were mounted so that angle
# is where the linkage rests without power. PAN 0 faces front; TILT 0 is the
# gimbal's own stop, which is why it has no negative travel. These angle limits
# are the real protection: the pulse guard below spans the whole SG90 range and
# would allow far more travel on its own.
SERVO_PAN_MIN_DEG=-90
SERVO_PAN_MAX_DEG=90
SERVO_TILT_MIN_DEG=0
SERVO_TILT_MAX_DEG=110
SERVO_PAN_PARK_DEG=0
SERVO_TILT_PARK_DEG=0
# Per-device calibration. Direction follows the linkage orientation and the
# home pulse follows where the horn was seated; both were measured on the bench
# on 2026-08-06. Re-measure after changing a servo, a horn or the mount.
SERVO_PAN_PULSE_DIRECTION=-1
SERVO_TILT_PULSE_DIRECTION=1
SERVO_PAN_HOME_PULSE_US=1500
SERVO_TILT_HOME_PULSE_US=611
# 495-2505us spans 180 physical degrees, so logical degrees are physical ones.
SERVO_PAN_PULSE_US_PER_DEGREE=11.1111
SERVO_TILT_PULSE_US_PER_DEGREE=11.1111
# SG90 datasheet range. A hardware backstop, not a travel limit.
SERVO_MINIMUM_PULSE_US=495
SERVO_MAXIMUM_PULSE_US=2505
# Motion tuning. The response gain turns normalized framing error into degrees
# per second; the speed limit caps how fast the controller may follow it. These
# are half of the pre-2026-08-06 values because the pulse scale doubled; the
# physical speed is unchanged.
SERVO_PAN_RESPONSE_GAIN=22.5
SERVO_TILT_RESPONSE_GAIN=22.5
SERVO_PAN_MAX_SPEED=20
SERVO_TILT_MAX_SPEED=20
SERVO_CONTROL_HZ=20
SERVO_STATUS_INTERVAL_SECONDS=0.5
# The controller holds by itself once targets stop arriving. Keep the nominal
# interval equal to the publisher's --command-interval; it is the gap assumed
# for the very first target, before a real interval can be measured.
SERVO_MESSAGE_TIMEOUT_SECONDS=0.75
SERVO_NOMINAL_MESSAGE_INTERVAL_SECONDS=0.1
# Startup safety. The default `park` ignores the saved state file and starts
# from the PARK angles, so a controller started before the servo supply is
# already holding an angle the linkage rests at. `persisted` restores the last
# commanded angles instead and is only safe when the servo rail is never cut.
# Under `persisted`, missing, stale or invalid state keeps the controller in
# STARTUP_WAITING with outputs off, and SIGUSR1 refuses to arm it.
SERVO_STARTUP_POSITION=park
# Set false when the servo supply is switched on by hand after the service
# starts, then arm it with `systemctl kill -s USR1 wj-servo-controller`.
SERVO_START_ARMED=true
SERVO_STATE_FILE=/var/lib/william-james-servo/position.json
SERVO_STATE_MAX_AGE_SECONDS=604800
SERVO_STATE_SAVE_INTERVAL_SECONDS=0.25
# Parking takes up to 5.5s from TILT +110 at 20deg/s. Raise this together with
# the unit's TimeoutStopSec if either range or the speed limit changes.
SERVO_SHUTDOWN_HOME_TIMEOUT_SECONDS=7

# Two-way audio (talkback). Keep this off until a speaker is physically wired:
# while unset the agent rejects START_TALKBACK with SPEAKER_UNAVAILABLE instead
# of accepting audio nobody can hear. The read URL is derived automatically from
# MEDIA_PUBLISH_URL_TEMPLATE (/live -> /talkback, same read-only credentials)
# and the default player is FFMPEG_PATH with ALSA output, so normally only
# these two lines are needed. wj-device-agent-jetson.service already grants the
# audio group. Pick the output device from `aplay -L`; "default" often routes
# to HDMI on Jetson, which is silent without monitor speakers.
# TALKBACK_ENABLED=true
# TALKBACK_OUTPUT_DEVICE=plughw:CARD=APE,DEV=0
# Ubuntu 22.04's FFmpeg 4.4 exposes TLS protocol options but cannot pass them
# through its RTSP demuxer after a successful RTSPS DESCRIBE. Jetson images with
# GStreamer can override the player while retaining certificate validation:
# TALKBACK_COMMAND='["/usr/bin/python3","/opt/william-james/device-agent/play_talkback_gstreamer.py","--output-device","plughw:CARD=Device,DEV=0","{url}"]'

# Live View relays the already encoded local stream only while a viewer exists.
FFMPEG_INPUT_ARGS='["-fflags","nobuffer","-flags","low_delay","-i","udp://127.0.0.1:23002?fifo_size=1000000&overrun_nonfatal=1"]'
FFMPEG_VIDEO_ARGS='["-c:v","copy"]'
FFMPEG_AUDIO_INPUT_ARGS='[]'
FFMPEG_AUDIO_ARGS='["-c:a","libopus","-b:a","64k","-ar","48000","-ac","1","-application","lowdelay"]'
FFMPEG_AUDIO_FROM_PRIMARY_INPUT=true
