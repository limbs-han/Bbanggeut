# Values returned by backend device provisioning. The device must also be
# claimed by the owner/admin account in the app.
DEVICE_ID=11111111-1111-4111-8111-111111111111
DEVICE_BEARER_TOKEN=wj_replace_me
FIRMWARE_VERSION=0.1.0-jetson
NODE_ID=jetson-gateway

MQTT_HOST=i15e201.p.ssafy.io
MQTT_PORT=8883
MQTT_ENV=prod
MQTT_CA_CERT=/etc/william-james/certs/mqtt-ca.crt
API_BASE_URL=https://i15e201.p.ssafy.io

# The production MediaMTX RTSP port is loopback-only. This idle SSH tunnel
# carries video only while the agent has an active viewer-triggered FFmpeg.
MEDIA_SSH_HOST=i15e201.p.ssafy.io
MEDIA_SSH_USER=ubuntu
MEDIA_SSH_PORT=22
MEDIA_SSH_KEY=/etc/william-james/ssh/media-tunnel.key
MEDIA_SSH_KNOWN_HOSTS=/etc/william-james/ssh/known_hosts
MEDIA_TUNNEL_LOCAL_PORT=18554
MEDIA_TUNNEL_REMOTE_HOST=127.0.0.1
MEDIA_TUNNEL_REMOTE_PORT=8554
MEDIA_PUBLISH_URL_TEMPLATE=rtsp://127.0.0.1:18554/live/{stream_id}

FFMPEG_PATH=/usr/bin/ffmpeg
CAMERA_DEVICE=/dev/video0
CAMERA_INPUT_FORMAT=mjpeg
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
VIDEO_BITRATE=2500k
AUDIO_DEVICE=plughw:CARD=B100,DEV=0
READY_DELAY_SECONDS=3

# The always-on media source opens the hardware once and publishes three
# loopback-only MPEG-TS copies. Nothing leaves the Jetson from these ports.
YOLO_UDP_PORT=23000
YAMNET_UDP_PORT=23001
LIVE_UDP_PORT=23002
YOLO_SOURCE_URL=udp://127.0.0.1:23000?fifo_size=1000000&overrun_nonfatal=1
YAMNET_SOURCE_URL=udp://127.0.0.1:23001?fifo_size=1000000&overrun_nonfatal=1
YAMNET_THRESHOLD=0.05
YAMNET_CONSECUTIVE=2

# Live View relays the already encoded local stream only while a viewer exists.
FFMPEG_INPUT_ARGS='["-fflags","nobuffer","-flags","low_delay","-i","udp://127.0.0.1:23002?fifo_size=1000000&overrun_nonfatal=1"]'
FFMPEG_VIDEO_ARGS='["-c:v","copy"]'
FFMPEG_AUDIO_INPUT_ARGS='[]'
FFMPEG_AUDIO_ARGS='["-c:a","aac","-b:a","128k","-ar","48000","-ac","1"]'
FFMPEG_AUDIO_FROM_PRIMARY_INPUT=true
