# Device identity returned by backend provisioning and enrollment.
DEVICE_ID=11111111-1111-4111-8111-111111111111
DEVICE_BEARER_TOKEN=wj_replace_me
DEVICE_CREDENTIAL_EXPIRES_AT=2026-08-22T00:00:00Z
FIRMWARE_VERSION=0.1.0-pi
NODE_ID=pi-gateway

# Device control plane: per-device MQTTS identity and ACL.
MQTT_HOST=i15e201.p.ssafy.io
MQTT_PORT=8883
MQTT_ENV=prod
MQTT_CA_CERT=/etc/william-james/certs/mqtt-ca.crt
API_BASE_URL=https://i15e201.p.ssafy.io

# The always-on homecam-publisher owns /dev/video0 and publishes H.264 to the
# loopback-only Raspberry Pi MediaMTX instance. The on-demand device agent reads
# that shared stream instead of opening the camera a second time.
FFMPEG_INPUT_ARGS='["-rtsp_transport","tcp","-i","rtsp://127.0.0.1:8554/homecam"]'
FFMPEG_VIDEO_ARGS='["-c:v","copy"]'

# Direct production ingest. Configure MediaMTX RTSPS, TLS, and a publish-only
# credential before using this URL. Keep the real password out of Git.
MEDIA_PUBLISH_URL_TEMPLATE=rtsps://wj-pi-001:replace_me@i15e201.p.ssafy.io:8322/live/{stream_id}

FFMPEG_PATH=/usr/bin/ffmpeg
READY_DELAY_SECONDS=3
