# Copy to a deployment-only secret file. Never commit real values.
DB_URL=jdbc:postgresql://127.0.0.1:5432/william_james
DB_USER=william
DB_PASSWORD=CHANGE_ME

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=500ms
REDIS_CONNECT_TIMEOUT=500ms
DEVICE_PRESENCE_TTL=90s

JWT_SIGNING_KEY=CHANGE_ME_AT_LEAST_32_BYTES
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=14d
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW=10m
PASSWORD_RESET_URL=bbanggeut://password-reset?token=
PASSWORD_RESET_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_AUTH=true
SMTP_STARTTLS=true

FCM_ENABLED=false
FIREBASE_PROJECT_ID=CHANGE_ME
# Absolute path to a deployment-only Firebase service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=/home/ubuntu/william-james/secrets/firebase-service-account.json

DEVICE_PROVISIONING_ENABLED=false
DEVICE_PROVISIONING_ADMIN_KEY=CHANGE_ME_AT_LEAST_32_BYTES

S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=william-james-videos
# 편집 서버(editor-api) 부산물 버킷. 영상 삭제 시 분석 캐시·초안·편집본을
# 함께 지운다. 비워 두면 청소를 건너뛴다.
S3_EDIT_BUCKET=william-james-edit
UPLOAD_STALE_AFTER=30m
UPLOAD_SWEEP_DELAY_MS=60000

MQTT_BROKER_URL=ssl://127.0.0.1:8883
MQTT_CLIENT_ID=wj-backend-prod
MQTT_USERNAME=wj-backend
MQTT_PASSWORD=CHANGE_ME
MQTT_ENV=prod

WEBRTC_BASE_URL=https://i15-team.p.ssafy.io/webrtc/live

STREAM_VIEWER_TTL=45s
STREAM_IDLE_TIMEOUT=60s
STREAM_EDGE_LEASE=120s
STREAM_HEARTBEAT_INTERVAL=15s
LIVE_TOKEN_TTL=30s
