[Unit]
Description=William James demo video loop
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
ExecStart=/usr/bin/ffmpeg -hide_banner -loglevel warning -re -stream_loop -1 -i /home/ubuntu/william-james/demo/YTDown.com_YouTube_Media_6Ycn9qZK09I_001_1080p.mp4 -map 0:v:0 -map 0:a:0? -c copy -f rtsp -rtsp_transport tcp rtsp://127.0.0.1:8554/demo-live
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadOnlyPaths=/home/ubuntu/william-james/demo

[Install]
WantedBy=multi-user.target
