[Unit]
Description=Check William James service dependencies
After=network-online.target docker.service william-james.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
ExecStart=/home/ubuntu/william-james/deploy/check-william-james.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/ubuntu/william-james
