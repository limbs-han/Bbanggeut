[Unit]
Description=William James Spring Boot API
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/william-james/app
EnvironmentFile=/home/ubuntu/william-james/secrets/app.env
ExecStart=/usr/bin/java -jar /home/ubuntu/william-james/app/server.jar --server.address=127.0.0.1 --server.port=8080
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/william-james

[Install]
WantedBy=multi-user.target
