# Copy to infra/.env and replace every CHANGE_ME value.
# Never commit the resulting .env file.

COMPOSE_PROJECT_NAME=william-james
BIND_ADDRESS=127.0.0.1

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_PORT=5432
POSTGRES_DB=william_james
POSTGRES_USER=william
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

MINIO_IMAGE=quay.io/minio/minio:latest
MINIO_MC_IMAGE=quay.io/minio/mc:latest
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=william-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_VIDEO_BUCKET=william-james-videos

MOSQUITTO_IMAGE=eclipse-mosquitto:2
MQTT_PORT=1883
MQTT_USERNAME=william-device
MQTT_PASSWORD=CHANGE_ME_MQTT_PASSWORD

SWAGGER_UI_IMAGE=swaggerapi/swagger-ui:latest
SWAGGER_UI_PORT=8081

